# --- settlement, exact fills against the order's own hold (no faults) ---
DEPOSIT u=9001 asset=0 amt=200000.0
DEPOSIT u=9002 asset=1 amt=2.0
HOLD order=7001 u=9002 asset=1 amt=1.0
HOLD order=7002 u=9001 asset=0 amt=60000.0
SETTLE tradeId=1 market=1 takerOrder=7002 takerUser=9001 makerOrder=7001 makerUser=9002 px=60000.0 qty=0.5 takerBuy=1
RELEASE order=7001 u=9002
RELEASE order=7002 u=9001

DEPOSIT u=9003 asset=1 amt=5.0

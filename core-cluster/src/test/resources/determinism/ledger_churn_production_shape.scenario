# --- a re-delivered trade must stay a no-op after all of the above ---
SETTLE tradeId=2 market=1 takerOrder=7003 takerUser=9003 makerOrder=7004 makerUser=9004 px=60000.0 qty=2.0 takerBuy=0

QUERY_FEED 1

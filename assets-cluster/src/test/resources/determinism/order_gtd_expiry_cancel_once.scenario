MEOUTCOME order=1 kind=0 attempt=0 result=0 leg=101
TICK 9900
ORDERSNAP u=1 corr=1
TICK 100
PENDINGDISPATCH corr=2
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100
TICK 100

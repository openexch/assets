# RC1 S6 (contract 1, 3.1, 3.2; spec R3, R4): a SELL STOP_LOSS arms PENDING_TRIGGER holding its base quantity.
# A tick whose best bid stays above the stop does not fire it (R3); the next tick with the TRUE best bid below
# the stop does (R4): one MeDispatch MARKET SELL child for the remaining quantity, attempt 1. The child leg is
# learned from its CREATE outcome, fills against a resting BUY in two trades, and the parent ends FILLED with
# no residual lock. The journal FILLED terminal after the last fill is a stale no-op.
CLOCK 1700000000000
GATE market=0 open=1
DEPOSIT u=1 asset=0 amt=10000.0
DEPOSIT u=2 asset=1 amt=5.0
MARKETTICK market=1 bid=100.0 ask=101.0 ver=1
CREATE u=2 market=1 side=1 type=3 qty=1.0 stop=99.0 rid=1       # order 1: armed, holds 1.0 base
CREATE u=1 market=1 side=0 type=0 px=97.0 qty=2.0 rid=2         # order 2: resting BUY
MEOUTCOME order=2 kind=0 attempt=0 result=0 leg=201
MARKETTICK market=1 bid=99.5 ask=100.0 ver=2                    # 99.5 > 99: no trigger
MARKETTICK market=1 bid=99.5 ask=100.0 ver=2                    # same bookVersion from a second forwarder: dropped
MARKETTICK market=1 bid=97.0 ask=100.0 ver=3                    # best bid 97 <= 99: triggers, child MARKET SELL qty 1.0
MEOUTCOME order=1 kind=0 attempt=1 result=0 leg=101
METRADE id=1 market=1 taker=1 maker=2 px=97.0 qty=0.4 takerBuy=0
METRADE id=2 market=1 taker=1 maker=2 px=97.0 qty=0.6 takerBuy=0  # parent FILLED, hold fully spent
METERMINAL order=1 leg=101 status=2                             # stale: the record is gone
MARKETTICK market=1 bid=90.0 ask=91.0 ver=4                     # nothing is armed any more: no dispatch

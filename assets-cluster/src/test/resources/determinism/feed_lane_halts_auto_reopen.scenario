# RC2 S10' 4R (contract S10p/contract.md 4R.1): the replicated lane-halt table and the automatic reopen of the
# order-entry gate after a GAP reach-clear. Two lanes halt GAP on two holes, the first fills (GLOBAL stays
# SUSPENDED/BRIDGE_HALT), the second fills seconds later (ONE automatic OPEN, no GATE command); an operator SUSPEND
# during a second halt survives the reopen; one identity from two sessions keeps max(seen); a SOURCE_SCHEMA
# reach-clear keeps the bit until OPEN; a ninth lane overflows and needs 76 {GAP, 0} plus OPEN.
# SnapshotReplayEquivalenceTest cuts it at every line: the table and the holder set ride section 12.
CLOCK 1000
V3GENESIS
GATE market=0 open=1 corr=1
DEPOSIT u=100 asset=0 amt=1000.0
# lane 1 (session 11) misses 2..3; lane 2 (session 12) misses 5..6, one apply later
FEEDHALT reason=GAP expected=2 seen=4 bridge=1 session=11 corr=2
FEEDHALT reason=GAP expected=5 seen=7 bridge=2 session=12 corr=3
QUERY_FEED 4
MECONFIG jseq=2 epoch=24301 cfg=2 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=3 epoch=24301 cfg=3 behavior=2 cap=4096 maxWire=12 decision=BUMP
# lane 1's hole is filled (c = 3): lane 2's record holds the gate
QUERY_FEED 5
MECONFIG jseq=4 epoch=24301 cfg=4 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=5 epoch=24301 cfg=5 behavior=2 cap=4096 maxWire=12 decision=BUMP
CLOCK 4000
# c = 6: lane 2's record reaches: the automatic OPEN
MECONFIG jseq=6 epoch=24301 cfg=6 behavior=2 cap=4096 maxWire=12 decision=BUMP
QUERY_FEED 6
# a second halt under an operator SUSPEND: the reopen clears BRIDGE_HALT only, ADMIN stays
FEEDHALT reason=GAP expected=7 seen=9 bridge=1 session=11 corr=7
GATE market=0 open=0 corr=8
MECONFIG jseq=7 epoch=24301 cfg=7 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=8 epoch=24301 cfg=8 behavior=2 cap=4096 maxWire=12 decision=BUMP
GATE market=0 open=1 corr=9
# one identity from two sessions: the second's smaller seen never weakens the record (seen stays 14)
FEEDHALT reason=GAP expected=9 seen=14 bridge=3 session=13 corr=10
FEEDHALT reason=GAP expected=9 seen=11 bridge=3 session=14 corr=11
FEEDHALT reason=GAP expected=9 seen=11 bridge=3 session=13 corr=12
MECONFIG jseq=9 epoch=24301 cfg=9 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=10 epoch=24301 cfg=10 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=11 epoch=24301 cfg=11 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=12 epoch=24301 cfg=12 behavior=2 cap=4096 maxWire=12 decision=BUMP
QUERY_FEED 13
MECONFIG jseq=13 epoch=24301 cfg=13 behavior=2 cap=4096 maxWire=12 decision=BUMP
# a SOURCE_SCHEMA reach-clear keeps the bit: the operator's OPEN
FEEDHALT reason=SOURCE_SCHEMA expected=14 seen=14 bridge=4 session=15 corr=14
MECONFIG jseq=14 epoch=24301 cfg=14 behavior=2 cap=4096 maxWire=12 decision=BUMP
QUERY_FEED 15
GATE market=0 open=1 corr=16
# nine lanes: the ninth goes to the overflow record, which never clears by reach
FEEDHALT reason=GAP expected=15 seen=17 bridge=11 session=21 corr=21
FEEDHALT reason=GAP expected=15 seen=17 bridge=12 session=22 corr=22
FEEDHALT reason=GAP expected=15 seen=17 bridge=13 session=23 corr=23
FEEDHALT reason=GAP expected=15 seen=17 bridge=14 session=24 corr=24
FEEDHALT reason=GAP expected=15 seen=17 bridge=15 session=25 corr=25
FEEDHALT reason=GAP expected=15 seen=17 bridge=16 session=26 corr=26
FEEDHALT reason=GAP expected=15 seen=17 bridge=17 session=27 corr=27
FEEDHALT reason=GAP expected=15 seen=17 bridge=18 session=28 corr=28
FEEDHALT reason=GAP expected=15 seen=17 bridge=19 session=29 corr=29
MECONFIG jseq=15 epoch=24301 cfg=15 behavior=2 cap=4096 maxWire=12 decision=BUMP
MECONFIG jseq=16 epoch=24301 cfg=16 behavior=2 cap=4096 maxWire=12 decision=BUMP
QUERY_FEED 30
GATE market=0 open=1 corr=31
LATCHCLEAR reason=GAP jseq=0 corr=32
GATE market=0 open=1 corr=33
QUERY_FEED 34

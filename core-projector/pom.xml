<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openexchange.core</groupId>
        <artifactId>core</artifactId>
        <version>0.1.0-runtime.20260928.r02d.g571248f</version>
    </parent>

    <artifactId>core-projector</artifactId>
    <packaging>jar</packaging>
    <properties>
        <!-- Overridden by the build with the short git sha. See the shade plugin's
             Build-Sha manifest entry for why this is never guessed. -->
        <buildSha>unknown</buildSha>
    </properties>
    <name>Core Money Projector</name>
    <description>Standalone agent: live-follows the core money journal (Aeron Archive recording) and
        idempotently projects every money movement into Postgres, resumable from the PG high-water</description>

    <dependencies>
        <!-- Internal: money-journal SBE schema + generated decoders + the shared ArchiveJournalSource
             follow helper. Deliberately does NOT depend on core-cluster (never connects to the core). -->
        <dependency>
            <groupId>com.openexchange.core</groupId>
            <artifactId>core-common</artifactId>
        </dependency>

        <!-- The engines' driver wait setting (EngineLifecycle.driverWaitMs); already on the classpath
             (and in the shaded jar) through core-common, declared because the projector now uses it directly. -->
        <dependency>
            <groupId>com.openexchange</groupId>
            <artifactId>cluster-kit</artifactId>
        </dependency>

        <!-- Aeron (full: embedded media driver + archive replay client for the journal recording) -->
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-all</artifactId>
        </dependency>

        <!-- Postgres: the projector's authoritative store. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- HikariCP logs via slf4j; a simple binding keeps pool logs readable (and silences the
             "no providers" warning) without pulling a full logging framework into the daemon. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- Uber JAR for the standalone projector agent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>core-projector</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.openexchange.core.projector.ProjectorMain</mainClass>
                                    <!-- Aeron/Agrona need these opens on JDK 17+; baking them into the
                                         manifest lets `java -jar core-projector.jar` run without
                                         repeating the flags on the command line. -->
                                    <manifestEntries>
                                        <Add-Opens>java.base/jdk.internal.misc java.base/sun.nio.ch java.base/java.nio</Add-Opens>
                                        <!-- Stamped so a deployed projector names the exact
                                             binary it runs. The default is the literal
                                             "unknown" rather than a guess, so a build without
                                             provenance says so instead of implying it. -->
                                        <Build-Sha>${buildSha}</Build-Sha>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

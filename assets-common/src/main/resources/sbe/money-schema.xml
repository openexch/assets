<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.openexchange.assets.infrastructure.generated"
                   id="2"
                   version="5"
                   semanticVersion="0.5"
                   description="Assets Engine money schema — balances, holds, settlement. All amounts are 8dp fixed-point int64."
>
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <!-- Group size encoding for variable-length groups (batches, later phases). -->
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <!-- Reason a money command was rejected (0=NONE on acks). -->
        <enum name="RejectReason" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="INSUFFICIENT_FUNDS">1</validValue>
            <validValue name="INVALID_AMOUNT">2</validValue>
            <validValue name="UNKNOWN_HOLD">3</validValue>
        </enum>
        <!-- Boolean-as-uint8 for taker side on a settlement (1 = taker is the buyer). -->
        <enum name="BoolFlag" encodingType="uint8">
            <validValue name="FALSE">0</validValue>
            <validValue name="TRUE">1</validValue>
        </enum>
        <!--
          Egress subscription channels (assets#17 follow-up, "step 3"). A session declares which
          classes of egress it wants; the default when a session never subscribes is ALL of them, so
          an old client that has never heard of Subscribe keeps working exactly as before.
        -->
        <set name="EgressChannels" encodingType="uint32">
            <choice name="acks"        description="responses to this client's own commands: hold/deposit/withdraw acks and rejects, feed position">0</choice>
            <choice name="balances"    description="the BalanceUpdate firehose: one per changed (user, asset) line">1</choice>
            <choice name="settlements" description="SettlementApplied and SettleFault">2</choice>
            <choice name="snapshots"   description="balance/hold snapshot streams and their terminators">3</choice>
            <choice name="orders"      description="RC0 spike: ProtoOrderEvent stream (order lifecycle events not addressed to the commanding session)">4</choice>
        </set>
        <!-- RC0 spike (OMS + ledger core measurement): prototype order lifecycle vocabulary. NOT a product wire contract. -->
        <enum name="ProtoSide" encodingType="uint8">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>
        <enum name="ProtoOrderType" encodingType="uint8">
            <validValue name="LIMIT">0</validValue>
            <validValue name="MARKET">1</validValue>
            <validValue name="STOP_LOSS">2</validValue>
            <validValue name="STOP_LIMIT">3</validValue>
            <validValue name="TRAILING_STOP">4</validValue>
            <validValue name="ICEBERG">5</validValue>
            <validValue name="LIMIT_MAKER">6</validValue>
        </enum>
        <enum name="ProtoTimeInForce" encodingType="uint8">
            <validValue name="GTC">0</validValue>
            <validValue name="IOC">1</validValue>
            <validValue name="FOK">2</validValue>
            <validValue name="GTD">3</validValue>
        </enum>
        <enum name="ProtoOrderStatus" encodingType="uint8">
            <validValue name="NEW">0</validValue>
            <validValue name="PARTIALLY_FILLED">1</validValue>
            <validValue name="FILLED">2</validValue>
            <validValue name="CANCELLED">3</validValue>
            <validValue name="REJECTED">4</validValue>
            <validValue name="EXPIRED">5</validValue>
        </enum>
        <enum name="ProtoRejectReason" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="RATE_LIMIT">1</validValue>
            <validValue name="CIRCUIT_BREAKER">2</validValue>
            <validValue name="SIZE">3</validValue>
            <validValue name="NOTIONAL">4</validValue>
            <validValue name="PRICE_COLLAR">5</validValue>
            <validValue name="OPEN_ORDERS">6</validValue>
            <validValue name="INSUFFICIENT_FUNDS">7</validValue>
            <validValue name="POSITION">8</validValue>
            <validValue name="DUPLICATE_CLIENT_ORDER_ID">9</validValue>
            <validValue name="UNKNOWN_ORDER">10</validValue>
            <validValue name="NOT_OWNER">11</validValue>
            <validValue name="INVALID">12</validValue>
            <validValue name="EXPIRED">13</validValue>
            <validValue name="NOT_OPEN">14</validValue>
        </enum>
    </types>

    <!-- ============================ Ingress commands (client -> AE) ============================ -->

    <sbe:message name="Deposit" id="1" description="Credit available balance (external boundary)">
        <field name="correlationId" id="1" type="int64" description="client-chosen id echoed on the ack; 0 = fire-and-forget"/>
        <field name="userId"        id="2" type="int64"/>
        <field name="assetId"       id="3" type="int32"/>
        <field name="amount"        id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="Withdraw" id="2" description="Debit available balance (external boundary)">
        <field name="correlationId" id="1" type="int64" description="client-chosen id echoed on the ack; 0 = fire-and-forget"/>
        <field name="userId"        id="2" type="int64"/>
        <field name="assetId"       id="3" type="int32"/>
        <field name="amount"        id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="Hold" id="3" description="Reserve funds for an order (available -> locked)">
        <field name="correlationId" id="1" type="int64" description="client-chosen id echoed on the ack; 0 = fire-and-forget"/>
        <field name="orderId"       id="2" type="int64"/>
        <field name="userId"        id="3" type="int64"/>
        <field name="assetId"       id="4" type="int32"/>
        <field name="amount"        id="5" type="int64"/>
        <field name="omsManagedRelease" id="6" type="BoolFlag" description="TRUE = the OMS owns this hold's terminal release (iceberg/stop PARENT holds: slices share the parent's omsOrderId, so a slice FILLED on the feed must not release the parent's residual); FALSE (default) = the feed's TerminalRelease releases normally"/>
    </sbe:message>

    <sbe:message name="Release" id="4" description="Release a hold's residual (locked -> available). amount &lt; 0 releases all remaining.">
        <field name="orderId" id="1" type="int64"/>
        <field name="userId"  id="2" type="int64"/>
        <field name="amount"  id="3" type="int64"/>
    </sbe:message>

    <sbe:message name="Settle" id="5" description="Apply a trade (feed-forward from the matching engine). Idempotent on tradeId.">
        <field name="tradeId"       id="1" type="int64"/>
        <field name="marketId"      id="2" type="int32"/>
        <field name="takerOrderId"  id="3" type="int64"/>
        <field name="takerUserId"   id="4" type="int64"/>
        <field name="makerOrderId"  id="5" type="int64"/>
        <field name="makerUserId"   id="6" type="int64"/>
        <field name="price"         id="7" type="int64"/>
        <field name="quantity"      id="8" type="int64"/>
        <field name="takerIsBuy"    id="9" type="BoolFlag"/>
        <field name="journalPosition" id="10" type="int64" description="ME settlement-journal egressSeq of this trade; drives consumePosition; 0 = direct ingress (tests/tools)"/>
    </sbe:message>

    <sbe:message name="TerminalRelease" id="6" description="feed-forward from the ME journal: order reached terminal state; release the order's full residual hold; unknown/gone hold = no-op">
        <field name="journalPosition" id="1" type="int64"/>
        <field name="orderId"         id="2" type="int64"/>
        <field name="userId"          id="3" type="int64"/>
        <field name="timestamp"       id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="QueryFeedPosition" id="7" description="read-only: answered with FeedPositionReport; deterministic no-op on state">
        <field name="correlationId" id="1" type="int64"/>
    </sbe:message>

    <sbe:message name="RequestBalanceSnapshot" id="8" description="read-only: leader streams BalanceUpdate per (user,asset) then BalanceSnapshotEnd">
        <field name="correlationId" id="1" type="int64"/>
    </sbe:message>

    <sbe:message name="RequestHoldSnapshot" id="9" description="read-only: leader streams HoldSnapshotEntry per hold then HoldSnapshotEnd">
        <field name="correlationId" id="1" type="int64"/>
    </sbe:message>

    <!-- Cutover primer, reserved in its own id range away from the day-to-day ingress traffic. -->
    <sbe:message name="InitTradeHighWater" id="30" description="cutover primer: refused (no-op) unless the ledger is virgin (lastAppliedTradeId==0 and no accounts)">
        <field name="tradeId"         id="1" type="int64"/>
        <field name="consumePosition" id="2" type="int64"/>
    </sbe:message>

    <sbe:message name="SetMoneyJournal" id="32" sinceVersion="4" description="Arm or disarm the money journal. This is REPLICATED STATE, not node configuration: journalSeq is snapshotted, so whether it advances has to be a property of the log rather than of a node's environment. Sent through the log, every replica flips at the same position, and a replay of that log flips there too -- which is what makes a bundle reproduce the ledger it captured. Whether a given node also WRITES its journal to disk is a separate, node-local matter.">
        <field name="correlationId" id="1" type="int64"/>
        <field name="enabled"       id="2" type="BoolFlag"/>
    </sbe:message>

    <sbe:message name="Subscribe" id="31" sinceVersion="3" description="Set this session's egress filter. Transport-level, NOT money state: it is never snapshotted, so a session that survives a leader change or a snapshot restore falls back to receiving everything (safe direction) and should re-subscribe.">
        <field name="correlationId" id="1" type="int64"/>
        <field name="channels"      id="2" type="EgressChannels"/>
    </sbe:message>

    <!-- v5 wire batching. Framing dominated the small money messages (~40B of Aeron+cluster framing
         per 28-69B body), and every frame was one offer on the deterministic service thread and one
         entry in the AE cluster log. Each batch entry carries EXACTLY its single-message fields with
         identical per-entry semantics; the single forms above stay valid for tools and tests. -->

    <sbe:message name="SettleBatch" id="33" sinceVersion="5" description="A run of Settle commands applied strictly in group order. Per-entry fields and semantics are identical to Settle (id=5), including tradeId idempotency and the journalPosition/consumePosition advance; one batch = one cluster log entry, which is the point.">
        <group name="settles" id="10" dimensionType="groupSizeEncoding">
            <field name="tradeId"       id="1" type="int64"/>
            <field name="marketId"      id="2" type="int32"/>
            <field name="takerOrderId"  id="3" type="int64"/>
            <field name="takerUserId"   id="4" type="int64"/>
            <field name="makerOrderId"  id="5" type="int64"/>
            <field name="makerUserId"   id="6" type="int64"/>
            <field name="price"         id="7" type="int64"/>
            <field name="quantity"      id="8" type="int64"/>
            <field name="takerIsBuy"    id="9" type="BoolFlag"/>
            <field name="journalPosition" id="11" type="int64" description="ME settlement-journal egressSeq of this trade; drives consumePosition; 0 = direct ingress (tests/tools)"/>
        </group>
    </sbe:message>

    <!-- ============================ Egress events (AE -> client) ============================ -->

    <sbe:message name="HoldAck" id="10" description="A hold was accepted">
        <field name="correlationId" id="1" type="int64"/>
        <field name="orderId"       id="2" type="int64"/>
        <field name="userId"        id="3" type="int64"/>
        <field name="assetId"       id="4" type="int32"/>
        <field name="amount"        id="5" type="int64"/>
    </sbe:message>

    <sbe:message name="HoldReject" id="11" description="A hold was rejected">
        <field name="correlationId" id="1" type="int64"/>
        <field name="orderId"       id="2" type="int64"/>
        <field name="userId"        id="3" type="int64"/>
        <field name="assetId"       id="4" type="int32"/>
        <field name="amount"        id="5" type="int64"/>
        <field name="reason"        id="6" type="RejectReason"/>
    </sbe:message>

    <sbe:message name="BalanceUpdate" id="12" description="A user's balance for one asset changed">
        <field name="userId"    id="1" type="int64"/>
        <field name="assetId"   id="2" type="int32"/>
        <field name="available" id="3" type="int64"/>
        <field name="locked"    id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="SettlementApplied" id="13" description="A trade was settled (idempotency confirmation)">
        <field name="tradeId"       id="1" type="int64"/>
        <field name="buyerUserId"   id="2" type="int64"/>
        <field name="sellerUserId"  id="3" type="int64"/>
    </sbe:message>

    <sbe:message name="WithdrawReject" id="14" description="A withdrawal was rejected">
        <field name="correlationId" id="1" type="int64"/>
        <field name="userId"        id="2" type="int64"/>
        <field name="assetId"       id="3" type="int32"/>
        <field name="amount"        id="4" type="int64"/>
        <field name="reason"        id="5" type="RejectReason"/>
    </sbe:message>

    <sbe:message name="DepositAck" id="15" description="A deposit was applied">
        <field name="correlationId"  id="1" type="int64"/>
        <field name="userId"         id="2" type="int64"/>
        <field name="assetId"        id="3" type="int32"/>
        <field name="amount"         id="4" type="int64"/>
        <field name="newAvailable"   id="5" type="int64"/>
    </sbe:message>

    <sbe:message name="WithdrawAck" id="16" description="A withdrawal was applied">
        <field name="correlationId"  id="1" type="int64"/>
        <field name="userId"         id="2" type="int64"/>
        <field name="assetId"        id="3" type="int32"/>
        <field name="amount"         id="4" type="int64"/>
        <field name="newAvailable"   id="5" type="int64"/>
    </sbe:message>

    <sbe:message name="FeedPositionReport" id="17" description="Answer to QueryFeedPosition: the ME journal cursor this AE has consumed">
        <field name="correlationId"       id="1" type="int64"/>
        <field name="consumePosition"     id="2" type="int64"/>
        <field name="lastAppliedTradeId"  id="3" type="int64"/>
        <!-- Appended in v4 (SBE-compatible: a v3 reader stops at the old block length). Without it a
             SetMoneyJournal command has no observable effect, and an operator would be left grepping
             three nodes' logs to find out whether the money journal is armed. -->
        <field name="journalEnabled"      id="4" type="BoolFlag" sinceVersion="4"/>
    </sbe:message>

    <sbe:message name="BalanceSnapshotEnd" id="18" description="Terminates the BalanceUpdate stream answering RequestBalanceSnapshot">
        <field name="correlationId" id="1" type="int64"/>
        <field name="entryCount"    id="2" type="int32"/>
    </sbe:message>

    <sbe:message name="HoldSnapshotEntry" id="19" description="One outstanding hold, streamed in answer to RequestHoldSnapshot">
        <field name="orderId"    id="1" type="int64"/>
        <field name="userId"     id="2" type="int64"/>
        <field name="assetId"    id="3" type="int32"/>
        <field name="remaining"  id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="SettleFault" id="21" description="A settle leg could not draw fully from its order hold (reconciler race / invariant breach): drawnFromAvailable was recovered from the user's available balance; uncovered could not be moved at all -- the counterparty was credited only what was debited, so conservation holds; nonzero uncovered demands operator action. MUST alert on this event.">
        <field name="tradeId"            id="1" type="int64"/>
        <field name="orderId"            id="2" type="int64"/>
        <field name="userId"             id="3" type="int64"/>
        <field name="assetId"            id="4" type="int32"/>
        <field name="drawnFromAvailable" id="5" type="int64"/>
        <field name="uncovered"          id="6" type="int64"/>
    </sbe:message>

    <sbe:message name="HoldSnapshotEnd" id="20" description="Terminates the HoldSnapshotEntry stream answering RequestHoldSnapshot">
        <field name="correlationId" id="1" type="int64"/>
        <field name="entryCount"    id="2" type="int32"/>
    </sbe:message>

    <!-- v5 egress batches: the publisher coalesces consecutive same-type events of one drain cycle
         into one frame per session. Entries are in emission order; per-entry fields are identical to
         the single form. HoldReject/DepositAck/WithdrawAck/WithdrawReject/SettleFault stay single
         (low rate; SettleFault must remain a loud standalone event). Snapshot replies stream as
         BalanceUpdateBatch / HoldSnapshotBatch chunks; the *End terminators are unchanged. -->

    <sbe:message name="BalanceUpdateBatch" id="22" sinceVersion="5" description="A run of BalanceUpdate events (id=12), in emission order">
        <group name="updates" id="10" dimensionType="groupSizeEncoding">
            <field name="userId"    id="1" type="int64"/>
            <field name="assetId"   id="2" type="int32"/>
            <field name="available" id="3" type="int64"/>
            <field name="locked"    id="4" type="int64"/>
        </group>
    </sbe:message>

    <sbe:message name="HoldAckBatch" id="23" sinceVersion="5" description="A run of HoldAck events (id=10), in emission order, correlationId echo included per entry">
        <group name="acks" id="10" dimensionType="groupSizeEncoding">
            <field name="correlationId" id="1" type="int64"/>
            <field name="orderId"       id="2" type="int64"/>
            <field name="userId"        id="3" type="int64"/>
            <field name="assetId"       id="4" type="int32"/>
            <field name="amount"        id="5" type="int64"/>
        </group>
    </sbe:message>

    <sbe:message name="SettlementAppliedBatch" id="24" sinceVersion="5" description="A run of SettlementApplied events (id=13), in emission order">
        <group name="settlements" id="10" dimensionType="groupSizeEncoding">
            <field name="tradeId"      id="1" type="int64"/>
            <field name="buyerUserId"  id="2" type="int64"/>
            <field name="sellerUserId" id="3" type="int64"/>
        </group>
    </sbe:message>

    <sbe:message name="HoldSnapshotBatch" id="25" sinceVersion="5" description="A run of HoldSnapshotEntry events (id=19) answering RequestHoldSnapshot; HoldSnapshotEnd (id=20) still terminates the stream">
        <group name="holds" id="10" dimensionType="groupSizeEncoding">
            <field name="orderId"    id="1" type="int64"/>
            <field name="userId"     id="2" type="int64"/>
            <field name="assetId"    id="3" type="int32"/>
            <field name="remaining"  id="4" type="int64"/>
        </group>
    </sbe:message>

    <!-- ======================= RC0 spike: prototype order lifecycle (measurement only) ======================= -->

    <sbe:message name="ProtoOrderCreate" id="40" description="RC0 spike ingress: place an order in the core (risk + hold + record)">
        <field name="correlationId"     id="1"  type="int64"/>
        <field name="userId"            id="2"  type="int64"/>
        <field name="clientOrderIdHigh" id="3"  type="int64"/>
        <field name="clientOrderIdLow"  id="4"  type="int64"/>
        <field name="requestIdHigh"     id="5"  type="int64"/>
        <field name="requestIdLow"      id="6"  type="int64"/>
        <field name="marketId"          id="7"  type="int32"/>
        <field name="side"              id="8"  type="ProtoSide"/>
        <field name="orderType"         id="9"  type="ProtoOrderType"/>
        <field name="timeInForce"       id="10" type="ProtoTimeInForce"/>
        <field name="price"             id="11" type="int64"/>
        <field name="quantity"          id="12" type="int64"/>
        <field name="stopPrice"         id="13" type="int64"/>
        <field name="displayQty"        id="14" type="int64"/>
        <field name="expiresAtMs"       id="15" type="int64"/>
        <field name="flags"             id="16" type="uint32"/>
    </sbe:message>

    <sbe:message name="ProtoOrderCancel" id="41" description="RC0 spike ingress: cancel an open core order (owner only)">
        <field name="correlationId" id="1" type="int64"/>
        <field name="userId"        id="2" type="int64"/>
        <field name="orderId"       id="3" type="int64"/>
    </sbe:message>

    <sbe:message name="ProtoOrderFill" id="42" description="RC0 spike ingress: a trade between two core orders (stands in for the ME journal feed)">
        <field name="correlationId" id="1" type="int64"/>
        <field name="tradeId"       id="2" type="int64"/>
        <field name="marketId"      id="3" type="int32"/>
        <field name="buyOrderId"    id="4" type="int64"/>
        <field name="sellOrderId"   id="5" type="int64"/>
        <field name="price"         id="6" type="int64"/>
        <field name="quantity"      id="7" type="int64"/>
        <field name="takerIsBuy"    id="8" type="BoolFlag"/>
    </sbe:message>

    <sbe:message name="ProtoOrderEvent" id="43" description="RC0 spike egress: one order lifecycle event">
        <field name="correlationId" id="1"  type="int64"/>
        <field name="orderId"       id="2"  type="int64"/>
        <field name="userId"        id="3"  type="int64"/>
        <field name="marketId"      id="4"  type="int32"/>
        <field name="status"        id="5"  type="ProtoOrderStatus"/>
        <field name="reason"        id="6"  type="ProtoRejectReason"/>
        <field name="filledQty"     id="7"  type="int64"/>
        <field name="remainingQty"  id="8"  type="int64"/>
        <field name="lastPrice"     id="9"  type="int64"/>
        <field name="lastQty"       id="10" type="int64"/>
        <field name="holdAmount"    id="11" type="int64"/>
        <field name="updatedAtMs"   id="12" type="int64"/>
        <field name="eventSeq"      id="13" type="int64"/>
    </sbe:message>

    <sbe:message name="ProtoRiskConfig" id="44" description="RC0 spike ingress: per-market risk limits (replicated; defaults apply until set)">
        <field name="correlationId"        id="1"  type="int64"/>
        <field name="marketId"             id="2"  type="int32"/>
        <field name="maxOrdersPerSec"      id="3"  type="int32"/>
        <field name="maxOrdersPerMin"      id="4"  type="int32"/>
        <field name="minQty"               id="5"  type="int64"/>
        <field name="maxQty"               id="6"  type="int64"/>
        <field name="maxNotional"          id="7"  type="int64"/>
        <field name="collarPct"            id="8"  type="int32"/>
        <field name="maxOpenOrders"        id="9"  type="int32"/>
        <field name="maxPositionPerMarket" id="10" type="int64"/>
        <field name="circuitBreaker"       id="11" type="BoolFlag"/>
    </sbe:message>

</sbe:messageSchema>
